/
  Cache-Control: no-store
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval'; script-src-elem 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/engine-yq.wasm
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/engine-dasel.wasm
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/engine-yq.wasm.gz
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/engine-dasel.wasm.gz
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/wasm_exec.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/yq-worker.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/dasel-worker.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
