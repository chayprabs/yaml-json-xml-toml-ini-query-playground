{
  "name": "yaml-json-xml-toml-ini-query-playground",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:engine && next build",
    "build:all": "npm run build:engine && next build",
    "start": "next start",
    "build:engine": "bash scripts/build-engine.sh",
    "phase1:audit": "node scripts/phase1-audit.cjs",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "playwright test",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "npm run build:engine && playwright test",
    "test:go": "node scripts/test-go.cjs"
  },
  "description": "Pluck is a fully static browser playground for config queries and format conversion with yq and dasel.",
  "author": "Chaitanya Prabuddha",
  "dependencies": {
    "lz-string": "1.5.0",
    "next": "15.5.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-syntax-highlighter": "15.6.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "15.5.18",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.15.17",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "15.5.13",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.18",
    "globals": "^17.4.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
